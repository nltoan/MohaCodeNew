<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/Upload/.*" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/Media_Share/.*" negate="true" />

            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- CSP admin: http://mohaapi.tefli.vn = API, http://moha.tefli.vn = portal/media (cho giu staging, script phat hanh thay).
         Origin portal/media co trong img/media/frame-src: HtmlEditor nhung video upload (REACT_APP_UPLOAD_URL = MediaUrl) bang iframe.
         Plyr dung plyr.svg/plyr-blank.mp4 tu host (khong cho cdn.plyr.io). cdnjs: grapesjs tai font-awesome 4.7 (cssIcons mac dinh). ckeditor-csp.js cho CKEditor 4 chay khong can inline script.
         Khong them 'unsafe-inline' vao script-src: token admin nam trong localStorage. Scripts/Test-AdminCsp.cjs kiem tra policy nay. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src &apos;self&apos;; script-src &apos;self&apos;; style-src &apos;self&apos; &apos;unsafe-inline&apos; https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src &apos;self&apos; data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src &apos;self&apos; data: blob: http://mohaapi.tefli.vn http://moha.tefli.vn; media-src &apos;self&apos; blob: http://mohaapi.tefli.vn http://moha.tefli.vn; connect-src &apos;self&apos; http://mohaapi.tefli.vn; frame-src &apos;self&apos; http://mohaapi.tefli.vn http://moha.tefli.vn https://www.youtube.com https://www.youtube-nocookie.com; worker-src &apos;self&apos; blob:; object-src &apos;none&apos;; base-uri &apos;self&apos;; form-action &apos;self&apos; http://mohaapi.tefli.vn; frame-ancestors &apos;none&apos;" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
