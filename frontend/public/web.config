<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- handle bots -->
        <rule name="Bot-News" stopProcessing="true">
          <match url="(tin-tuc|minister/tin-tuc|nghiquyettw4/tin-tuc)/.*-id([0-9]+)$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="facebookexternalhit|twitterbot|linkedinbot|zbot|telegrambot" />
          </conditions>
          <action type="Rewrite" url="http://mohaapi.tefli.vn/api/Public/GetBotMetaForTinTuc?id={R:2}" />
        </rule>

        <rule name="Bot-Announcement" stopProcessing="true">
          <match url="thong-bao/.*-id([0-9]+)$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="facebookexternalhit|twitterbot|linkedinbot|zbot|telegrambot" />
          </conditions>
          <action type="Rewrite" url="http://mohaapi.tefli.vn/api/Public/GetBotMetaForThongBao?id={R:1}" />
        </rule>

        <rule name="Bot-Documents" stopProcessing="true">
          <match url="van-ban/.*-id([0-9]+)$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="facebookexternalhit|twitterbot|linkedinbot|zbot|telegrambot" />
          </conditions>
          <action type="Rewrite" url="http://mohaapi.tefli.vn/api/Public/GetBotMetaForVanBan?id={R:1}" />
        </rule>

        <rule name="Bot-DraftDocuments" stopProcessing="true">
          <match url="van-ban/du-thao/.*-id([0-9]+)$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="facebookexternalhit|twitterbot|linkedinbot|zbot|telegrambot" />
          </conditions>
          <action type="Rewrite" url="http://mohaapi.tefli.vn/api/Public/GetBotMetaForVanBanDuThao?id={R:1}" />
        </rule>

        <rule name="Bot-Research" stopProcessing="true">
          <match url="nghien-cuu-khoa-hoc/.*-id([0-9]+)$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="facebookexternalhit|twitterbot|linkedinbot|zbot|telegrambot" />
          </conditions>
          <action type="Rewrite" url="http://mohaapi.tefli.vn/api/Public/GetBotMetaForNghienCuu?id={R:1}" />
        </rule>

        <rule name="Bot-Photo" stopProcessing="true">
          <match url="photo/.*-id([0-9]+)$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="facebookexternalhit|twitterbot|linkedinbot|zbot|telegrambot" />
          </conditions>
          <action type="Rewrite" url="http://mohaapi.tefli.vn/api/Public/GetBotMetaForPhoto?id={R:1}" />
        </rule>

        <rule name="Bot-Video" stopProcessing="true">
          <match url="video/.*-id([0-9]+)$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="facebookexternalhit|twitterbot|linkedinbot|zbot|telegrambot" />
          </conditions>
          <action type="Rewrite" url="http://mohaapi.tefli.vn/api/Public/GetBotMetaForVideo?id={R:1}" />
        </rule>
        
        <rule name="Bot-Audio" stopProcessing="true">
          <match url="audio/.*-id([0-9]+)$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="facebookexternalhit|twitterbot|linkedinbot|zbot|telegrambot" />
          </conditions>
          <action type="Rewrite" url="http://mohaapi.tefli.vn/api/Public/GetBotMetaForAudio?id={R:1}" />
        </rule>

        <!-- van ban du thao, van ban quy pham phap luat, van ban chi dao dieu hanh -->
        <rule name="van-ban-du-thao" enabled="true" stopProcessing="true">
          <match url="^van-ban/van-ban-du-thao.html" />
          <action type="Redirect" url="/van-ban/du-thao-van-ban" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-van-ban-du-thao" enabled="true" stopProcessing="true">
          <match url="^van-ban/van-ban-du-thao/([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Redirect" url="/van-ban/du-thao/{R:1}---oid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-van-ban-quy-pham-phap-luat" enabled="true" stopProcessing="true">
          <match url="^van-ban/van-ban-quy-pham.html" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="ItemID=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/van-ban/---qpid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="van-ban-quy-pham-phap-luat" enabled="true" stopProcessing="true">
          <match url="^van-ban/van-ban-quy-pham.html" />
          <action type="Redirect" url="/van-ban/van-ban-qppl/---id101" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-thong-bao" enabled="true" stopProcessing="true">
          <match url="^thong-bao/([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Redirect" url="/van-ban/{R:1}---tbid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-thong-bao-splink" enabled="true" stopProcessing="true">
          <match url="^thong-bao/Pages/dsthongbao.aspx" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="ItemID=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/van-ban/---tbid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="thong-bao" enabled="true" stopProcessing="true">
          <match url="^thong-bao.html" />
          <action type="Redirect" url="/van-ban/van-ban-cddh/---id104" redirectType="Permanent" />
        </rule>
        <rule name="van-ban-chi-dao-dieu-hanh" enabled="true" stopProcessing="true">
          <match url="^vanban/Pages/van-ban-chi-dao-dieu-hanh.aspx" />
          <action type="Redirect" url="/van-ban/van-ban-cddh/---id104" redirectType="Permanent" />
        </rule>
        <!-- khong co' page tuong ung tren he thong moi
        ==> migrate sang table Giới thiệu văn bản
        <rule name="van-ban-moi" enabled="true">
          <match url="^van-ban/van-ban-moi.html" />
          <action type="Rewrite" url="vanban/Pages/van-ban-moi.aspx" />
        </rule>
        ==> migrate sang table Giới thiệu văn bản
        <rule name="chi-tiet-van-ban-moi" enabled="true">
          <match url="^van-ban/van-ban-moi/([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Rewrite" url="vanban/Pages/van-ban-moi.aspx?ItemID={R:2}" />
        </rule>
        -->

        <!-- bo truong -->
        <rule name="bo-truong" enabled="true" stopProcessing="true">
          <match url="^bo-truong.html" />
          <action type="Redirect" url="/bo-truong" redirectType="Permanent" />
        </rule>
        <rule name="trang-tin-tuc-bo-truong" enabled="true" stopProcessing="true">
          <match url="^bo-truong/tin-tuc.html" />
          <action type="Redirect" url="/bo-truong/tin-tuc" redirectType="Permanent" />
        </rule>
        <rule name="danh-sach-tin-bo-truong-khong-anh" enabled="true" stopProcessing="true">
          <match url="^bo-truong/tin-tuc/([_0-9a-z-]+)-d([0-9]+).html" />
          <action type="Redirect" url="/bo-truong/chuyen-muc/{R:1}---btid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="botruong-infographics" enabled="true" stopProcessing="true">
          <match url="^bo-truong/gioi-thieu/infographics/([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Redirect" url="/bo-truong/gioi-thieu-bo-truong/---gtbtid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="ds-bai-viet-bo-truong-theo-danh-muc" enabled="true" stopProcessing="true">
          <match url="^bo-truong/tin-tuc/([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Redirect" url="bo-truong/chuyen-muc/{R:1}---btid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="ds-bai-viet-bo-truong-theo-danh-muc-khong-anh" enabled="true" stopProcessing="true">
          <match url="^bo-truong/([_0-9a-z-]+)-d([0-9]+).html" />
          <action type="Redirect" url="bo-truong/chuyen-muc/{R:1}---btid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-tin-su-kien-bo-truong" enabled="true" stopProcessing="true">
          <match url="^bo-truong/tin-tuc/([_0-9a-z-]+)/([_0-9a-z-]+)-s([0-9]+)-t([0-9]+).html" />
          <action type="Redirect" url="bo-truong/tin-tuc/{R:2}---btid{R:4}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-bo-truong-theo-danh-muc" enabled="true" stopProcessing="true">
          <match url="^bo-truong/tin-tuc/([_0-9a-z-]+)/([_0-9a-z-]+)-d([0-9]+)-t([0-9]+).html" />
          <action type="Redirect" url="/bo-truong/tin-tuc/{R:2}---btid{R:4}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-bo-truong-moipt1" enabled="true" stopProcessing="true">
          <match url="/bo-truong/tin-tuc/([_0-9a-z-]+)-t([0-9]+).html" />
          <action type="Redirect" url="/bo-truong/tin-tuc/{R:1}---btid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-bo-truong-splink" enabled="true" stopProcessing="true">
          <match url="^bo-truong/tin-tuc/Pages/listbnv.aspx" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="ItemID=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/bo-truong/tin-tuc/---btid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-bo-truong-splink2" enabled="true" stopProcessing="true">
          <match url="^bo-truong/tin-tuc/Pages/listbnv.aspx" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="Cat=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/bo-truong/chuyen-muc/---btid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-bo-truong-splink3" enabled="true" stopProcessing="true">
          <match url="^bo-truong/tin-tuc/Pages/listbnv.aspx" />
          <action type="Redirect" url="/bo-truong/tin-tuc" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <!-- khong co page tuong ung tren he thong moi
        <rule name="chi-tiet-bai-viet-gioi-thieu-tdkt" enabled="true">
          <match url="^bo-truong/bai-viet-gioi-thieu/gioi-thieu-bo-truong/([_0-9a-z-]+)-bt([0-9]+).html" />
          <action type="Rewrite" url="bo-truong/gioi-thieu/Pages/chi-tiet.aspx?ItemID={R:2}" />
        </rule>
        <rule name="thong-bao-bo-truong" enabled="true">
          <match url="^bo-truong/thong-bao.html" />
          <action type="Rewrite" url="bo-truong/Pages/danh-sach-thong-bao.aspx" />
        </rule>
        <rule name="chi-tiet-thong-bao-bo-truong" enabled="true">
          <match url="^bo-truong/thong-bao/([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Rewrite" url="bo-truong/Pages/danh-sach-thong-bao.aspx?ItemId={R:2}" />
        </rule>
        -->

        <!-- nghi quyet tw4 -->
        <rule name="nghi-quyet-tw4" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4.html" />
          <action type="Redirect" url="/nghi-quyet-tw4" redirectType="Permanent" />
        </rule>
        <rule name="trang-tin-tuc-nghi-quyet" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/tin-tuc.html" />
          <action type="Redirect" url="/nghi-quyet-tw4/tin-tuc" redirectType="Permanent" />
        </rule>
        <rule name="danh-sach-tin-nghi-quyet-link-theo-chuyen-muc" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/(([_0-9a-z-]+)/)*([_0-9a-z-]+)-d([0-9]+).html" />
          <action type="Redirect" url="/nghi-quyet-tw4/chuyen-muc/{R:3}---nqid{R:4}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-nghi-quyet-moipt1" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/su-kien/([_0-9a-z-]+)-t([0-9]+).html" />
          <action type="Redirect" url="/nghi-quyet-tw4/tin-tuc/{R:1}---nqid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="danh-sach-su-kien-nghi-quyet" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/su-kien/([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Redirect" url="/nghi-quyet-tw4/chuyen-muc/{R:1}---nqid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-tin-su-kien-nghi-quyet" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/tin-tuc/([_0-9a-z-]+)/([_0-9a-z-]+)-s([0-9]+)-t([0-9]+).html" />
          <action type="Redirect" url="nghi-quyet-tw4/tin-tuc/{R:2}---nqid{R:4}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-nghi-quyet-theo-danh-muc" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/([_0-9a-z-]+)/([_0-9a-z-]+)-d([0-9]+)-t([0-9]+).html" />
          <action type="Redirect" url="/nghi-quyet-tw4/tin-tuc/{R:2}---nqid{R:4}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-nghi-quyet" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/tin-tuc/([_0-9a-z-]+)-t([0-9]+).html" />
          <action type="Redirect" url="/nghi-quyet-tw4/tin-tuc/{R:1}---nqid{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-nghi-quyet-tw4-splink" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/tin-tuc/Pages/listbnv.aspx" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="ItemID=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/nghi-quyet-tw4/tin-tuc/---nqid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-nghi-quyet-tw4-splink2" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/tin-tuc/Pages/listbnv.aspx" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="Cat=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/nghi-quyet-tw4/chuyen-muc/---nqid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="chi-tiet-bai-viet-nghi-quyet-tw4-splink3" enabled="true" stopProcessing="true">
          <match url="^nghi-quyet-tw4/tin-tuc/Pages/listbnv.aspx" />
          <action type="Redirect" url="/nghi-quyet-tw4/tin-tuc" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <!-- khong co page tuong ung tren he thong moi
        <rule name="chi-tiet-bai-viet-gioi-thieu-nghi-quyet" enabled="true">
          <match url="^nghi-quyet-tw4/bai-viet-gioi-thieu/([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Rewrite" url="nghi-quyet-tw4/gioi-thieu/Pages/chi-tiet.aspx?ItemID={R:2}" />
        </rule>
        <rule name="danh-sach-tin-nghi-quyet-khong-anh-theo-chuyen-muc" enabled="true">
          <match url="^nghi-quyet-tw4/tin-tuc-khong-anh/([_0-9a-z-]+)-d([0-9]+).html" />
          <action type="Rewrite" url="/nghi-quyet-tw4/tin-tuc/Pages/list.aspx?Cat={R:2}" />
        </rule>
        -->

        <!-- nghien cuu khoa hoc -->
        <rule name="chi-tiet-nghien-cuu-khoa-hoc" enabled="true" stopProcessing="true">
          <match url="^nghien-cuu-khoa-hoc.html" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="ItemID=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/nghien-cuu-khoa-hoc/---oid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="nghien-cuu-khoa-hoc" enabled="true" stopProcessing="true">
          <match url="^nghien-cuu-khoa-hoc.html" />
          <action type="Redirect" url="/nghien-cuu-khoa-hoc" redirectType="Permanent" />
        </rule>

        <!-- tin tuc -->
        <rule name="trang-tin-tuc" enabled="true" stopProcessing="true">
          <match url="^tin-tuc.html" />
          <action type="Redirect" url="/tintuc/Pages/listbnv.aspx" redirectType="Permanent" />
        </rule>
        <!-- trang danh muc tin tuc -->
        <rule name="danh-muc-tin-tuc" enabled="true" stopProcessing="true">
          <match url="^(([_0-9a-z-]+)/)*([_0-9a-z-]+)-([0-9]+).html" />
          <action type="Redirect" url="/chuyen-muc/{R:3}---oid{R:4}" redirectType="Permanent" />
        </rule>
        <rule name="danhmuc-tin-tuc-khong-hinh-anh" enabled="true" stopProcessing="true">
          <match url="^(([_0-9a-z-]+)/)*([_0-9a-z-]+)-d([0-9]+).html" />
          <action type="Redirect" url="/chuyen-muc/{R:3}---oid{R:4}" redirectType="Permanent" />
        </rule>
        <!-- trang danh sach tin tuc theo su kien -->
        <rule name="danh-sach-tin-tuc-theo-su-kien" enabled="true" stopProcessing="true">
          <match url="^(([_0-9a-z-]+)/)*([_0-9a-z-]+)-s([0-9]+).html" />
          <action type="Redirect" url="/chuyen-muc/{R:3}---oid{R:4}" redirectType="Permanent" />
        </rule>
        <!-- trang chi tiet bai viet theo danh muc -->
        <rule name="chi-tiet-bai-viet-theo-danh-muc" enabled="true" stopProcessing="true">
          <match url="^(([_0-9a-z-]+)/)*([_0-9a-z-]+)-d([0-9]+)-t([0-9]+).html" />
          <action type="Redirect" url="/tin-tuc/{R:3}---oid{R:5}" redirectType="Permanent" />
        </rule>
        <!-- trang chi tiet bai viet theo su kien -->
        <rule name="chi-tiet-bai-viet-theo-su-kien" enabled="true" stopProcessing="true">
          <match url="^(([_0-9a-z-]+)/)*([_0-9a-z-]+)-s([0-9]+)-t([0-9]+).html" />
          <action type="Redirect" url="/tin-tuc/{R:3}---oid{R:5}" redirectType="Permanent" />
        </rule>
        <!-- trang chi tiet bai viet (khong co danh muc) -->
        <rule name="chi-tiet-bai-viet-khong-danh-muc" enabled="true" stopProcessing="true">
          <match url="^(([_0-9a-z-]+)/)*([_0-9a-z-]+)-t([0-9]+).html" />
          <action type="Redirect" url="/tin-tuc/{R:3}---oid{R:4}" redirectType="Permanent" />
        </rule>
        <!-- trang chi tiet bai viet noi bat theo SharePoint link -->
        <rule name="chi-tiet-bai-viet-noi-bat-splink" enabled="true" stopProcessing="true">
          <match url="^tintuc/Pages/danh-sach-tin-noi-bat.aspx" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="ItemID=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/tin-tuc/---oid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <!-- trang chi tiet bai viet danh sahc theo SharePoint link -->
        <rule name="chi-tiet-bai-viet-theo-danh-sach-splink" enabled="true" stopProcessing="true">
          <match url="^tintuc/Pages/listbnv.aspx" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="ItemID=([0-9]+)" />
          </conditions>
          <action type="Redirect" url="/tin-tuc/---oid{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>

        <rule name="Redirect-KND-to-Upload" enabled="true" stopProcessing="true">
          <match url="^KND/(.*)" />
          <action type="Redirect" url="/Upload/KND/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/Upload/.*" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/Media_Share/.*" negate="true" />

            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>